<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>workshop-complete</id>
    <formats>
        <format>dir</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <!-- The name the docs use for the workshop root. GitHub wraps the zip of each download branch in a
         directory of its own, so this is what the attendee finds inside it. -->
    <baseDirectory>quarkus-workshop-super-heroes</baseDirectory>

    <fileSets>
        <fileSet>
            <outputDirectory>./</outputDirectory>
            <directory>${basedir}/target/temp-project</directory>
            <includes>
                <include>mvnw*</include>
                <include>.mvn/wrapper/maven-wrapper.properties</include>
            </includes>
        </fileSet>
        <fileSet>
            <outputDirectory>./super-heroes</outputDirectory>
            <directory>${basedir}/target/temp-project</directory>
            <includes>
                <include>mvnw*</include>
                <include>.mvn/wrapper/maven-wrapper.properties</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>extensions</directory>
            <useDefaultExcludes>true</useDefaultExcludes>
            <excludes>
                <exclude>**/target/**</exclude>
                <exclude>**/.idea/**</exclude>
                <exclude>*.iml</exclude>
                <exclude>*.settings</exclude>
                <exclude>*.classpath</exclude>
                <exclude>*.project</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>super-heroes</directory>
            <useDefaultExcludes>true</useDefaultExcludes>
            <excludes>
                <exclude>**/target/**</exclude>
                <exclude>**/node/**</exclude>
                <exclude>**/node_modules/**</exclude>
                <exclude>**/dist/**</exclude>
                <exclude>**/.idea/**</exclude>
                <exclude>*.iml</exclude>
                <exclude>*.settings</exclude>
                <exclude>*.classpath</exclude>
                <exclude>*.project</exclude>
                <exclude>**/bootstrap.sh</exclude>
                <exclude>**/ObjectStore</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>${basedir}</directory>
            <useDefaultExcludes>true</useDefaultExcludes>
            <includes>
                <include>pom.xml</include>
                <include>settings.gradle.kts</include>
                <include>build.gradle.kts</include>
                <include>gradle.properties</include>
                <include>gradlew*</include>
                <include>gradle/wrapper/*</include>
                <include>.editorconfig</include>
                <include>.mvn/wrapper/maven-wrapper.properties</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
