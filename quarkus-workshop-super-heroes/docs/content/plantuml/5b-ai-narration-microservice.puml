@startuml
' This diagram has !ifdef use_<flag> guards, so it is rendered once per set of flags. Every
' plantuml:: macro that uses it needs target=<this file's name>-{diagram-key}, or the variants
' overwrite each other's renders; DiagramTargetsTest checks for it. A guard on a flag that no
' diagram used before also needs that flag in diagramFlags in src/resource-generation/generate-variants.java.
!include style.puml

left to right direction

rectangle "Narration" as hero {
    agent "QUARKUS_ICON Quarkus" <<application>> as narrationQuarkus
    hexagon "LangChain4j" as sk
    narrationQuarkus .up> sk
}

!ifdef use_azure
cloud "Open AI \n Azure OpenAI" as openai
!else
cloud "LLM Provider \n (OpenAI, Ollama, Gemini, etc.)" as openai
!endif

() "REST" as rest #4695EB
rest -- narrationQuarkus
sk --> openai : HTTP

@enduml
