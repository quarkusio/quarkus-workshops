<?xml version="1.0" encoding="UTF-8"?>
<!-- How to use this build file
Run mvn verify (or install) to generate a default doc and test it.

Tests come in two halves. The *Test classes are @QuarkusTest + @RoqAndRoll: they generate the
canonical site into target/roq-test in-process and serve it, so mvn test is enough to run them
and they work from an IDE with no build first. The *IT classes assert against the assembled site
in target/roq, which quarkus:run writes at pre-integration-test, so only verify runs those.

Run mvn quarkus:dev to preview the docs with live reload on http://localhost:8067.
Run -Dtesty to re-run the tests against an already-generated target/roq without rebuilding the site.
Run -Dos=[linux|mac|windows|all] to generate docs for a single OS. Don't forget to run clean if you switch os.
Run -Dfull to generate a full set of docs, which will be a slow build.
Run -Dvariants.complete=true when the site under test has every OS's variants merged into it, as
the assembled site in CI does; AssemblySmokeIT then checks them all instead of just -Dos.

-->

<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.quarkus.workshop.super-heroes</groupId>
    <artifactId>docs</artifactId>
    <version>2.0</version>
    <packaging>quarkus</packaging>
    <name>Quarkus Workshop :: Super-Heroes :: Docs</name>

    <properties>
        <version.asciidoctorj.diagram.plantuml>1.2026.2</version.asciidoctorj.diagram.plantuml>
        <version.playwright>1.63.0</version.playwright>
        <!-- since we don't use roq-specific playwright features yet, do not pay the cost -->
        <!-- If building docs locally and urls matter, set environment variables for these values.
             Tests set these via systemPropertyVariables in surefire plugin configuration. -->
        <github.raw>
            https://raw.githubusercontent.com/${env.GITHUB_REPOSITORY}/${env.GITHUB_REF}/quarkus-workshop-super-heroes
        </github.raw>
        <github.repo>${env.GITHUB_SERVER_URL}/${env.GITHUB_REPOSITORY}</github.repo>
        <github.url>${github.repo}/tree/${env.GITHUB_REF}/quarkus-workshop-super-heroes</github.url>
        <base.url>${env.BASE_URL}</base.url>
        <!-- qrcode.url needs a default because it's used at compile time by jbang plugin, before
             tests run. Override with -Dqrcode.url=... when building for a different base URL. -->
        <qrcode.url>https://quarkusio.github.io/quarkus-workshops/super-heroes/</qrcode.url>
        <github.issue>${github.repo}/issues</github.issue>
        <!-- Note! Any versions listed here should have a dummy dependency clause so dependabot manages the versions -->
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus</quarkus.platform.group-id>
        <quarkus.platform.version>3.39.4</quarkus.platform.version>
        <quarkus.pact.version>1.6.0</quarkus.pact.version>
        <quarkus-langchain4j.version>1.9.2</quarkus-langchain4j.version>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <maven.compiler.release>21</maven.compiler.release>
        <!-- The build date, for the docdate attribute. It is rendered as a plain date, not parsed.
             maven.build.timestamp is not itself visible to resource filtering, so it has to be
             copied into an ordinary property to be referenced as an at-sign token. -->
        <maven.build.timestamp.format>yyyy-MM-dd</maven.build.timestamp.format>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <os>all</os>
        <docdate>${maven.build.timestamp}</docdate>
        <!-- The url prefix the site is published under, e.g. /quarkus-workshops/super-heroes, with
             no trailing slash. It has to be baked into the generated html, because imagesdir and
             assetsdir are urls rather than filesystem paths and the pages that use them sit at
             several different depths. Empty by default, which is right for quarkus:dev and for
             the test-phase tests; build.yml passes the published prefix. -->
        <docs.site-path/>
        <!-- The documentation tests are failsafe ITs, because they assert against the generated
             site and so have to run after quarkus:run has produced it. Skipping them by default
             would mean `mvn verify` silently tests nothing. -->
        <skipITs>false</skipITs>
        <roq.version>2.1.9</roq.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Managed, not depended on: these are extensions the docs tell the reader to add to
                 their own projects, so they must not join the docs application, but dependabot
                 still has to see them to keep {quarkus-pact-version} and
                 {quarkus-langchain4j-version} in step with super-heroes/rest-fights and
                 super-heroes/rest-narration -->
            <dependency>
                <groupId>io.quarkiverse.pact</groupId>
                <artifactId>quarkus-pact-consumer</artifactId>
                <version>${quarkus.pact.version}</version>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.langchain4j</groupId>
                <artifactId>quarkus-langchain4j-bom</artifactId>
                <version>${quarkus-langchain4j.version}</version>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Yes, depending on a plugin is a bit unusual; it's so dependabot can manage it without affecting the docs build -->
        <dependency>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>${compiler-plugin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>${surefire-plugin.version}</version>
        </dependency>
        <!-- Normal dependencies we want dependabot to apply updates to -->
        <dependency>
            <groupId>io.quarkiverse.roq</groupId>
            <artifactId>quarkus-roq</artifactId>
            <version>${roq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.roq</groupId>
            <artifactId>quarkus-roq-testing</artifactId>
            <version>${roq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.roq</groupId>
            <artifactId>quarkus-roq-plugin-asciidoc-jruby</artifactId>
            <version>${roq.version}</version>
        </dependency>
        <dependency>
            <groupId>org.asciidoctor</groupId>
            <artifactId>asciidoctorj-diagram-plantuml</artifactId>
            <version>${version.asciidoctorj.diagram.plantuml}</version>
        </dependency>
        <!-- Playwright for documentation testing -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${version.playwright}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- src/main/resources/application.properties carries the doc attributes that come from
                 Maven (versions, GitHub urls), so that they apply to quarkus:dev as well as to the
                 static build. See the comments in that file. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <!-- The *Test classes are @QuarkusTest + @RoqAndRoll: they generate the canonical
                     site in-process and serve it, so they need no prior build and run from an IDE
                     unchanged. Anything that needs the assembled variants runs under failsafe
                     below instead.

                     No parallel configuration here, deliberately: every @RoqAndRoll class binds
                     the same port, so the classes have to run one at a time. -->
                <configuration>
                    <systemPropertyVariables>
                        <!-- Somewhere of its own to generate into. Roq cleans its output directory,
                             so sharing target/roq with the real build would delete the assembled
                             variants out from under the ITs. -->
                        <quarkus.roq.generator.output-dir>roq-test</quarkus.roq.generator.output-dir>
                        <!-- Pass through the os property so ConfiguratorTest can filter appropriately -->
                        <os>${os}</os>
                        <variants.config.path>${basedir}/data/variants.json</variants.config.path>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <!-- Pinned, not passed through from ${docs.site-path}: @RoqAndRoll serves this
                             site at the document root, so the pages it generates have to ask for
                             assets at the root too. Surefire hands the Maven JVM's system
                             properties to the fork, so without these a `-Ddocs.site-path=...` build
                             would generate a prefix the in-process server does not answer on. -->
                        <quarkus.asciidoc.attributes.imagesdir>/images</quarkus.asciidoc.attributes.imagesdir>
                        <quarkus.asciidoc.attributes.assetsdir>/assets</quarkus.asciidoc.attributes.assetsdir>
                        <!-- Rendered diagrams go into the generated site rather than into public/,
                             so this has to follow the output-dir override above. See the comment
                             on imagesoutdir in config/application.properties. -->
                        <quarkus.asciidoc.attributes.imagesoutdir>${project.build.directory}/roq-test/images
                        </quarkus.asciidoc.attributes.imagesoutdir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <junit.jupiter.execution.parallel.enabled>true</junit.jupiter.execution.parallel.enabled>
                        <junit.jupiter.execution.parallel.mode.default>concurrent
                        </junit.jupiter.execution.parallel.mode.default>
                        <junit.jupiter.execution.parallel.mode.classes.default>concurrent
                        </junit.jupiter.execution.parallel.mode.classes.default>
                        <junit.jupiter.execution.parallel.config.strategy>fixed
                        </junit.jupiter.execution.parallel.config.strategy>
                        <junit.jupiter.execution.parallel.config.fixed.parallelism>4
                        </junit.jupiter.execution.parallel.config.fixed.parallelism>
                        <!-- Pass through the os property so ConfiguratorIT can filter appropriately -->
                        <os>${os}</os>
                        <!-- The assembled site has docs.site-path baked into its asset urls, so
                             SiteServer has to serve it under that prefix rather than at the
                             document root. See BrowserIT. -->
                        <docs.site-path>${docs.site-path}</docs.site-path>
                        <variants.config.path>${basedir}/data/variants.json</variants.config.path>
                        <native.image.path>${project.build.directory}/${project.build.finalName}-runner
                        </native.image.path>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <!-- Phases matter here. Anything this plugin is bound to at or before
                         process-classes is re-invoked by DevMojo, which injects a `mode` parameter
                         that only generate-code declares, so `quarkus:dev` dies with
                         "Cannot find 'mode' in class io.quarkus.maven.BuildMojo". Keeping build at
                         its natural `package` and the site generation at pre-integration-test
                         leaves dev mode alone and still lets one `mvn verify` build the site and
                         then test it. -->
                    <execution>
                        <id>default-build</id>
                        <phase>package</phase>
                        <goals>
                            <goal>build</goal>
                        </goals>
                        <configuration>
                            <!-- The quarkus.asciidoc.attributes.* that come from Maven live in
                                 src/main/resources/application.properties, which is filtered, so that
                                 they reach quarkus:dev as well as this forked build. These two are
                                 the ones that must *differ* between dev and the static build, so
                                 they stay here: the static build renders the per-variant copies
                                 under target/content, dev renders the live content/ directory. -->
                            <systemProperties>
                                <!-- Cannot be absolute -->
                                <site.content-dir>target/content</site.content-dir>
                                <docs.site-path>${docs.site-path}</docs.site-path>
                                <quarkus.roq.generator.batch>true</quarkus.roq.generator.batch>
                                <skipTests>true</skipTests>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-run</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <!-- Booting the built application is what makes the Roq generator write
                                 the site to target/roq. The failsafe ITs that follow assert against
                                 it. -->
                            <systemProperties>
                                <site.content-dir>target/content</site.content-dir>
                                <!-- The prefix the published site is served under; it ends up in
                                     the imagesdir and assetsdir urls of every page written here. -->
                                <docs.site-path>${docs.site-path}</docs.site-path>
                            </systemProperties>
                            <additionalSystemProperties>
                                skipTests=true
                            </additionalSystemProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Cache the roq output for variant iterations -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>cache-roq-output</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <replace token="include::" value="include::../../"
                                         dir="${project.build.directory}/content/variants/">
                                    <include name="**/*adoc"/>
                                </replace>
                                <replace token="include::../../options.adoc" value="include::options.adoc"
                                         dir="${project.build.directory}/content/variants/">
                                    <include name="**/*adoc"/>
                                </replace>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <phase>compile</phase>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/content/variants"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>2.6</version>
                <configuration>
                    <!-- Filter on @...@ only. The filtered application.properties is full of
                         ${...} Quarkus config expressions that have to reach the runtime intact,
                         and the default ${...} delimiter would eat them. -->
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                    <delimiters>
                        <delimiter>@</delimiter>
                    </delimiters>
                </configuration>
                <executions>
                    <execution>
                        <id>copy-content</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <!-- The directory should already exist -->
                            <outputDirectory>${project.build.directory}/content/
                            </outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/content</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Generate variant directory structure (contains options.adoc, plantuml-config.puml per variant).
                 This provides the input data for building individual variant sites. -->
            <plugin>
                <groupId>dev.jbang</groupId>
                <artifactId>jbang-maven-plugin</artifactId>
                <version>0.0.7</version>
                <executions>
                    <execution>
                        <id>generate-variant-structure</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <script>src/resource-generation/generate-variants.java</script>
                            <args>
                                <arg>${basedir}/data/variants.json</arg>
                                <arg>${project.build.directory}/content/variants</arg>
                                <arg>--os</arg>
                                <arg>${os}</arg>
                                <arg>--spine-source</arg>
                                <arg>${basedir}/content/spine.adoc</arg>
                                <arg>--defaults</arg>
                                <arg>${basedir}/content/options.adoc</arg>
                            </args>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-qrcode</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <script>src/resource-generation/qrcode.java</script>
                            <args>
                                <arg>${qrcode.url}</arg>
                                <arg>public/images/qrcode.png</arg>
                            </args>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>quick-build</id>
            <activation>
                <property>
                    <name>!full</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>restore-cached-roq-output</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- Allows running tests without running a full roq build, which would be slow
            Annoyingly, it seems there's no way to say run just this phase, we have to manually exclude everything else -->
            <id>tests-only</id>
            <activation>
                <property>
                    <name>testy</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.quarkus</groupId>
                        <artifactId>quarkus-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-build</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>default-run</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>restore-cached-roq-output</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>cache-roq-output</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>dev.jbang</groupId>
                        <artifactId>jbang-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>generate-qrcode</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>env-defaults</id>
            <activation>
                <property>
                    <name>!env.GITHUB_SERVER_URL</name>
                </property>
            </activation>
            <properties>
                <!-- Fallback values when environment variables are not set (local dev, older CI) -->
                <env.GITHUB_SERVER_URL>https://github.com</env.GITHUB_SERVER_URL>
                <env.GITHUB_REPOSITORY>quarkusio/quarkus-workshops</env.GITHUB_REPOSITORY>
                <env.GITHUB_REF>main</env.GITHUB_REF>
                <env.BASE_URL>https://quarkusio.github.io/</env.BASE_URL>
            </properties>
        </profile>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
