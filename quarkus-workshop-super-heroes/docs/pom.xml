<?xml version="1.0" encoding="UTF-8"?>
<!-- How to use this build file
Run mvn verify (or install) to generate a default doc and test it. The site is written by
quarkus:run at pre-integration-test, and the failsafe ITs in src/test assert against it, so
anything short of verify (mvn compile, mvn package) builds no site and runs no tests.
Run mvn quarkus:dev to preview the docs with live reload on http://localhost:8067.
Run -Dtesty to re-run the ITs against an already-generated target/roq without rebuilding the site.
Run -Dos=[linux|mac|windows|all] to generate docs for a single OS. Don't forget to run clean if you switch os.
TODO it would be nice if that wasn't needed.
Run -Dfull to generate a full set of docs, which will be a slow build.

-->

<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.quarkus.workshop.super-heroes</groupId>
    <artifactId>docs</artifactId>
    <version>2.0</version>
    <packaging>quarkus</packaging>
    <name>Quarkus Workshop :: Super-Heroes :: Docs</name>

    <properties>
        <version.asciidoctorj.diagram.plantuml>1.2026.2</version.asciidoctorj.diagram.plantuml>
        <version.playwright>1.63.0</version.playwright>
        <!-- since we don't use roq-specific playwright features yet, do not pay the cost -->
        <!-- If building docs locally and urls matter, set environment variables for these values -->
        <github.raw>
            https://raw.githubusercontent.com/${env.GITHUB_REPOSITORY:[repo]}/${env.GITHUB_REF:[github-ref]}/quarkus-workshop-super-heroes
        </github.raw>
        <github.repo>${env.GITHUB_SERVER_URL:[server]}/${env.GITHUB_REPOSITORY:[repo]}</github.repo>
        <github.url>${github.repo}/tree/${env.GITHUB_REF:[github-ref]}/quarkus-workshop-super-heroes</github.url>
        <base.url>${env.BASE_URL:[base-url]}</base.url>
        <github.issue>${github.repo}/issues</github.issue>
        <quarkus.pact.version>1.6.0</quarkus.pact.version>
        <quarkus-langchain4j.version>1.9.2</quarkus-langchain4j.version>
        <compiler-plugin.version>3.16.0</compiler-plugin.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.38.3</quarkus.platform.version>
        <os>all</os>
        <!-- The documentation tests are failsafe ITs, because they assert against the generated
             site and so have to run after quarkus:run has produced it. Skipping them by default
             would mean `mvn verify` silently tests nothing. -->
        <skipITs>false</skipITs>
        <surefire-plugin.version>3.6.0</surefire-plugin.version>
        <roq.version>2.1.9</roq.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Managed, not depended on: these are extensions the docs tell the reader to add to
                 their own projects, so they must not join the docs application, but dependabot
                 still has to see them to keep {quarkus-pact-version} and
                 {quarkus-langchain4j-version} in step with super-heroes/rest-fights and
                 super-heroes/rest-narration -->
            <dependency>
                <groupId>io.quarkiverse.pact</groupId>
                <artifactId>quarkus-pact-consumer</artifactId>
                <version>${quarkus.pact.version}</version>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.langchain4j</groupId>
                <artifactId>quarkus-langchain4j-bom</artifactId>
                <version>${quarkus-langchain4j.version}</version>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Yes, depending on a plugin is a bit unusual; it's so dependabot can manage it without affecting the docs build -->
        <dependency>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>${compiler-plugin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>${surefire-plugin.version}</version>
        </dependency>
        <!-- Normal dependencies we want dependabot to apply updates to -->
        <dependency>
            <groupId>io.quarkiverse.roq</groupId>
            <artifactId>quarkus-roq</artifactId>
            <version>${roq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.roq</groupId>
            <artifactId>quarkus-roq-testing</artifactId>
            <version>${roq.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.roq</groupId>
            <artifactId>quarkus-roq-plugin-asciidoc-jruby</artifactId>
            <version>${roq.version}</version>
        </dependency>
        <dependency>
            <groupId>org.asciidoctor</groupId>
            <artifactId>asciidoctorj-diagram-plantuml</artifactId>
            <version>${version.asciidoctorj.diagram.plantuml}</version>
        </dependency>
        <!-- Playwright for documentation testing -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${version.playwright}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- src/main/resources/application.properties carries the doc attributes that come from
                 Maven (versions, GitHub urls), so that they apply to quarkus:dev as well as to the
                 static build. See the comments in that file. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <!-- There are no unit tests; everything in src/test asserts against the generated
                     site, so it runs under failsafe below. The declaration stays to pin the
                     version, which dependabot tracks via the dependency on the plugin. -->
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <junit.jupiter.execution.parallel.enabled>true</junit.jupiter.execution.parallel.enabled>
                        <junit.jupiter.execution.parallel.mode.default>concurrent
                        </junit.jupiter.execution.parallel.mode.default>
                        <junit.jupiter.execution.parallel.mode.classes.default>concurrent
                        </junit.jupiter.execution.parallel.mode.classes.default>
                        <junit.jupiter.execution.parallel.config.strategy>fixed
                        </junit.jupiter.execution.parallel.config.strategy>
                        <junit.jupiter.execution.parallel.config.fixed.parallelism>4
                        </junit.jupiter.execution.parallel.config.fixed.parallelism>
                        <!-- Pass through the os property so ConfiguratorIT can filter appropriately -->
                        <os>${os}</os>
                        <variants.config.path>${basedir}/data/variants.json</variants.config.path>
                        <native.image.path>${project.build.directory}/${project.build.finalName}-runner
                        </native.image.path>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <!-- Phases matter here. Anything this plugin is bound to at or before
                         process-classes is re-invoked by DevMojo, which injects a `mode` parameter
                         that only generate-code declares, so `quarkus:dev` dies with
                         "Cannot find 'mode' in class io.quarkus.maven.BuildMojo". Keeping build at
                         its natural `package` and the site generation at pre-integration-test
                         leaves dev mode alone and still lets one `mvn verify` build the site and
                         then test it. -->
                    <execution>
                        <id>default-build</id>
                        <phase>package</phase>
                        <goals>
                            <goal>build</goal>
                        </goals>
                        <configuration>
                            <!-- The quarkus.asciidoc.attributes.* that come from Maven live in
                                 src/main/resources/application.properties, which is filtered, so that
                                 they reach quarkus:dev as well as this forked build. These two are
                                 the ones that must *differ* between dev and the static build, so
                                 they stay here: the static build renders the per-variant copies
                                 under target/content, dev renders the live content/ directory. -->
                            <systemProperties>
                                <!-- TODO Cannot be absolute -->
                                <site.content-dir>target/content</site.content-dir>
                                <quarkus.roq.generator.batch>true</quarkus.roq.generator.batch>
                                <skipTests>true</skipTests>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-run</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <!-- Booting the built application is what makes the Roq generator write
                                 the site to target/roq. The failsafe ITs that follow assert against
                                 it. -->
                            <systemProperties>
                                <site.content-dir>target/content</site.content-dir>
                            </systemProperties>
                            <additionalSystemProperties>
                                skipTests=true
                            </additionalSystemProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Cache the roq output for variant iterations -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>cache-roq-output</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- TODO why is this two up, not one up? -->
                                <replace token="include::" value="include::../../"
                                         dir="${project.build.directory}/content/variants/">
                                    <include name="**/*adoc"/>
                                </replace>
                                <replace token="include::../../options.adoc" value="include::options.adoc"
                                         dir="${project.build.directory}/content/variants/">
                                    <include name="**/*adoc"/>
                                </replace>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <phase>compile</phase>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/content/variants"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>2.6</version>
                <configuration>
                    <!-- Filter on @...@ only. The filtered application.properties is full of
                         ${...} Quarkus config expressions that have to reach the runtime intact,
                         and the default ${...} delimiter would eat them. -->
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                    <delimiters>
                        <delimiter>@</delimiter>
                    </delimiters>
                </configuration>
                <executions>
                    <execution>
                        <id>copy-content</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <!-- The directory should already exist -->
                            <outputDirectory>${project.build.directory}/content/
                            </outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/content</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Generate variant directory structure (contains options.adoc, plantuml-config.puml per variant).
                 This provides the input data for building individual variant sites. -->
            <plugin>
                <groupId>dev.jbang</groupId>
                <artifactId>jbang-maven-plugin</artifactId>
                <version>0.0.7</version>
                <executions>
                    <execution>
                        <id>generate-variant-structure</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <script>src/resource-generation/generate-variants.java</script>
                            <args>
                                <arg>${basedir}/data/variants.json</arg>
                                <arg>${project.build.directory}/content/variants</arg>
                                <arg>--os</arg>
                                <arg>${os}</arg>
                            </args>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Multi-variant HTML generation via iterator-maven-plugin.
                 For each variant directory, copies its application.properties to config/,
                 then runs quarkus:run which picks up the variant name via MicroProfile Config.
                 VariantConfig CDI bean parses workshop.variant.name to determine flags. -->
            <plugin>
                <groupId>com.soebes.maven.plugins</groupId>
                <artifactId>iterator-maven-plugin</artifactId>
                <version>0.5.1</version>
                <executions>
                    <execution>
                        <id>build-variant-sites</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>iterator</goal>
                        </goals>
                        <configuration>
                            <folder>${project.build.directory}/content/variants</folder>
                            <pluginExecutors>
                                <pluginExecutor>
                                    <plugin>
                                        <groupId>com.soebes.maven.plugins</groupId>
                                        <artifactId>echo-maven-plugin</artifactId>
                                        <version>0.5.0</version>
                                    </plugin>
                                    <goal>echo</goal>
                                    <configuration>
                                        <echos>
                                            <echo>Generating asciidoc using options from @item@</echo>
                                        </echos>
                                    </configuration>
                                </pluginExecutor>
                                <!--
                                We can only use a pre-built app for generation once, so save and re-use a copy before each run
                                Restore cached roq output before running variant -->
                                <pluginExecutor>
                                    <plugin>
                                        <artifactId>maven-resources-plugin</artifactId>
                                        <version>2.6</version>
                                    </plugin>
                                    <goal>copy-resources</goal>
                                    <configuration>
                                        <!-- The directory should already exist -->
                                        <outputDirectory>${project.build.directory}/content/variants/@item@/
                                        </outputDirectory>
                                        <resources>
                                            <resource>
                                                <directory>${project.basedir}/content</directory>
                                                <filtering>false</filtering>
                                                <includes>
                                                    <include>spine.adoc</include>
                                                </includes>
                                            </resource>
                                        </resources>
                                    </configuration>
                                </pluginExecutor>
                            </pluginExecutors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>quick-build</id>
            <activation>
                <property>
                    <name>!full</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.soebes.maven.plugins</groupId>
                        <artifactId>iterator-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-variant-sites</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${surefire-plugin.version}</version>
                        <configuration>
                            <systemPropertyVariables>
                                <docs.base.path>${project.build.directory}/roq</docs.base.path>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>com.soebes.maven.plugins</groupId>
                        <artifactId>iterator-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-variant-sites</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>restore-cached-roq-output</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- Allows running tests without running a full roq build, which would be slow
            Annoyingly, it seems there's no way to say run just this phase, we have to manually exclude everything else -->
            <id>tests-only</id>
            <activation>
                <property>
                    <name>testy</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.quarkus</groupId>
                        <artifactId>quarkus-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-build</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>default-run</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>restore-cached-roq-output</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>cache-roq-output</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
