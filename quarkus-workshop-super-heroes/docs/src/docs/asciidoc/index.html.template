                    <input type="radio" name="osOption" id="linuxRadio" value="linux" onchange="onRadioChange()"><i
                    class="fab fa-linux"></i>Linux
                </label></li>
        </ul>

        <h4 class="no-underline"><i class="fas fa-wrench"></i>What build tool are you using?</h4>
        <ul class="configurator">
            <li>
                <label for="mavenRadio">
                    <input type="radio" name="buildToolOption" id="mavenRadio" value="maven" checked onchange="onRadioChange()">Maven
                </label>
            </li>
            <li>
                <label for="gradleRadio">
                    <input type="radio" name="buildToolOption" id="gradleRadio" value="gradle" onchange="onRadioChange()">Gradle
                </label>
            </li>
        </ul>

        <!-- Flags with a "section" (e.g. locked-down) are rendered here, each under its own heading -->
        <div id="custom-sections"></div>

        <h4 class="no-underline" id="feature-selector"><i class="fas fa-book"></i>What content would you like to
            include?
        </h4>
        <div class="select-controls">
            <a href="#" onclick="selectAll(); return false;">Select all</a> / <a href="#" onclick="selectNone(); return false;">none</a>
        </div>
        <!-- Checkboxes are generated dynamically from variants-config.json -->
        <ul class="configurator" id="feature-checkboxes"></ul>

        <div id="standalone-section" style="display:none">
            <h4 class="no-underline" id="standalone-selector"><i class="fas fa-puzzle-piece"></i>Standalone modules
            </h4>
            <ul class="configurator" id="standalone-checkboxes"></ul>
        </div>

        <button class="big" id="workshop-button" onclick="navigateToWorkshop()">
            Take me to my default workshop
        </button>
    </div>
</div>

<script>
    // Create the <li> for a single flag checkbox
    function createFlagCheckbox(flag) {
        const li = document.createElement('li');
        li.id = `use-${flag.id}-li`;
        const label = document.createElement('label');
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.id = `use-${flag.id}`;
        input.addEventListener('change', () => onCheckboxChange(flag.id));
        label.appendChild(input);
        if (flag.icon) {
            const icon = document.createElement('i');
            icon.className = flag.icon;
            label.appendChild(icon);
        }
        let labelText = flag.label;
        if (flag.requires && flag.requires.length > 0) {
            labelText += ` (needs ${flag.requires.join(', ')})`;
        }
        label.appendChild(document.createTextNode(labelText));
        li.appendChild(label);
        return li;
    }

    // Build checkboxes dynamically from config
    function buildCheckboxes() {
        const featureList = document.getElementById('feature-checkboxes');
        const customSections = document.getElementById('custom-sections');
        const standaloneList = document.getElementById('standalone-checkboxes');
        const standaloneSection = document.getElementById('standalone-section');

        contentFlags.forEach(flag => featureList.appendChild(createFlagCheckbox(flag)));

        // Group sectioned flags by their section name and render each under its own heading
        const sectionLists = {};
        sectionedFlags.forEach(flag => {
            if (!sectionLists[flag.section]) {
                const heading = document.createElement('h4');
                heading.className = 'no-underline';
                const icon = document.createElement('i');
                icon.className = flag.sectionIcon || 'fas fa-tag';
                heading.appendChild(icon);
                heading.appendChild(document.createTextNode(flag.section));
                customSections.appendChild(heading);
                const ul = document.createElement('ul');
                ul.className = 'configurator';
                customSections.appendChild(ul);
                sectionLists[flag.section] = ul;
            }
            sectionLists[flag.section].appendChild(createFlagCheckbox(flag));
        });

        if (standaloneFlags.length > 0) {
            standaloneSection.style.display = '';
            standaloneFlags.forEach(flag => standaloneList.appendChild(createFlagCheckbox(flag)));
        }
    }

    buildCheckboxes();

    // Pre-check toggles that match the default values (without applying constraints yet)
    enabledFlags.forEach(flag => {
        if (flag.defaultValue) {
            const cb = document.getElementById(`use-${flag.id}`);
            if (cb) {
                cb.checked = true;
            }
        }
    });

    // Handle URL parameters for pre-setting options
    const urlParams = new URLSearchParams(window.location.search);
    const hideDefined = urlParams.get("hideDefined")?.toLowerCase() === "true";
    for (const [key, value] of urlParams.entries()) {
        if (key === "os") {
            const radioId = value === "all" ? "allRadio" : `${value}Radio`;
            const input = document.querySelector(`input[id="${radioId}"]`);
            if (input) {
                input.checked = true;
            }
        } else if (key === "buildTool") {
            if (value === "maven") document.getElementById("mavenRadio").checked = true;
            else if (value === "gradle") document.getElementById("gradleRadio").checked = true;
        } else if (key !== "hideDefined") {
            const input = document.querySelector(`input[id="use-${key}"]`);
            if (input) {
                if (value && value.toLowerCase() === "true") {
                    input.checked = true;
                } else {
                    input.checked = false;
                }
            }
            if (hideDefined) {
                const li = document.querySelector(`li[id="use-${key}-li"]`);
                if (li) {
                    li.hidden = true;
                }
            }
        }
    }

    // Apply constraints based on pre-checked defaults to ensure consistency
    // This must happen after URL params are processed to respect any overrides
    enabledFlags.forEach(f => {
        const cb = document.getElementById(`use-${f.id}`);
        if (cb && cb.checked) {
            enforceStandaloneConstraints(f.id, true);
            enforceConstraints(f.id, true);
        }
    });

    function hideHeaderIfAllChildrenAreHidden() {
        var lis = document.querySelectorAll("li[id^='use-'],li[id$='-li']");
        if (lis) {
            const visible = Array.from(lis).find(li => li.hidden == false);
            if (!visible) {
                const header = document.querySelector(`[id="feature-selector"]`);
                if (header) {
                    header.hidden = true;
                }
            }
        }
    }
    hideHeaderIfAllChildrenAreHidden();
</script>

</body>
